# Local application variables (for manual Python/compose.local.yaml use).
DATABASE_URL=postgresql://radar_local:replace-me@localhost:5432/fintech_radar
BLOCK=worker
MODEL=
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
MINI_APP_URL=

# New Coolify Radar resource only. Do not reuse Master variables or values.
# Use a unique lowercase slug for each Radar installation on the same host.
RADAR_INSTANCE_ID=prod-01
RADAR_POSTGRES_USER=radar_app
# Replace with a new random alphanumeric password in the Coolify secret settings.
RADAR_POSTGRES_PASSWORD=replace-with-a-radar-only-secret
RADAR_OPENROUTER_ENABLED=false
RADAR_OPENROUTER_API_KEY=
RADAR_MODEL=
RADAR_AI_AUTO_PROCESS=false
RADAR_TELEGRAM_ENABLED=false
RADAR_TELEGRAM_TOKEN=
RADAR_MINI_APP_URL=
