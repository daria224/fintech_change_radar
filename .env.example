# Postgres connection string. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/desk_research
# Key for the worker: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, the model the worker uses
MODEL=openai/gpt-4.1-mini
# Bot token from @BotFather, only for the bot block
TELEGRAM_TOKEN=
# Existing HTTPS feed domain (keep the current bot and domain)
MINI_APP_URL=
# Optional override for config/radar.json
# RADAR_CONFIG=/app/config/radar.json
# Which service to run: worker, bot, web, collector
BLOCK=worker
